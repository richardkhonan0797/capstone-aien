# Both n8n images must use the same version.
N8N_VERSION=2.48.4
TZ=Asia/Jakarta

POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Required: generate three different random secrets before starting.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=

# Local development. Update both URLs if you change the published port.
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=0
