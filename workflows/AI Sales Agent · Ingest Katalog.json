    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE retail.ingest_state \nSET \n    hash = md5(\n        COALESCE(\n            (SELECT string_agg(sumber || '|' || teks, ';' ORDER BY sumber) FROM retail.dokumen), \n            ''\n        ) \n        || \n        COALESCE(\n            (SELECT string_agg(sku || '|' || nama || '|' || harga::text || '|' || deskripsi, ';' ORDER BY sku) FROM retail.produk), \n            ''\n        )\n    ), \n    jumlah_dokumen = $1::int, \n    updated_at = now() \nWHERE \n    id = 1 \nRETURNING \n    jumlah_dokumen AS dokumen_masuk, \n    hash, \n    updated_at;",
        "options": {
          "queryReplacement": "={{ [ $('Susun Dokumen').all().length ] }}"
        }
