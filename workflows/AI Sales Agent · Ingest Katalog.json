    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH current_hash AS (\n    SELECT \n        md5(\n            COALESCE(\n                (SELECT string_agg(sumber || '|' || teks, ';' ORDER BY sumber) FROM retail.dokumen), \n                ''\n            ) \n            || \n            COALESCE(\n                (SELECT string_agg(sku || '|' || nama || '|' || harga::text || '|' || deskripsi, ';' ORDER BY sku) FROM retail.produk), \n                ''\n            )\n        ) AS hash_val\n)\nSELECT \n    (hash_val IS DISTINCT FROM (SELECT hash FROM retail.ingest_state)) AS berubah,\n    hash_val AS hash\nFROM current_hash;",
        "options": {}
      },
