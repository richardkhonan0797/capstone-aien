    {
      "parameters": {
        "jsCode": "const out = $('Ambil Produk').all().map(i => {\n  const p = i.json;\n  return { json: { tipe: 'produk', sku: p.sku, sumber: p.nama,\n    teks: `${p.nama}. Kategori ${p.kategori}. Harga Rp${Number(p.harga).toLocaleString('id-ID')}. ${p.deskripsi}` } };\n});\nfor (const d of $('Ambil Dokumen').all()) out.push({ json: { tipe: 'dokumen', sku: '', sumber: d.json.sumber, teks: d.json.teks } });\nreturn out;"
      },
