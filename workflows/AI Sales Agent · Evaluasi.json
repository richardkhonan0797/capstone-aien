    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nreturn [{ json: { run_id: 'run-' + new Date().toISOString().replace(/[-:T.Z]/g, '').slice(0, 14), limit: Math.min(Number(b.limit) || 20, 20) } }];"
      },
      "name": "Buat Run ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
