    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    run_id, \n    count(*)::int AS total, \n    round(100.0 * avg(benar::int), 1) AS benar_pct, \n    round(100.0 * avg(bersumber::int), 1) AS bersumber_pct, \n    round(100.0 * avg(halusinasi::int), 1) AS halusinasi_pct \nFROM retail.eval_hasil \nWHERE run_id = $1::text \nGROUP BY run_id;",
        "options": {
          "queryReplacement": "={{ [ $('Buat Run ID').first().json.run_id ] }}"
        }
      },
