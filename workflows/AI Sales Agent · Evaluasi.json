    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO retail.eval_hasil (\n    run_id, \n    qid, \n    pertanyaan, \n    jawaban, \n    sumber, \n    benar, \n    bersumber, \n    halusinasi, \n    catatan\n) \nVALUES (\n    $1::text, \n    $2::int, \n    $3::text, \n    $4::text, \n    $5::text, \n    $6::boolean, \n    $7::boolean, \n    $8::boolean, \n    $9::text\n) \nRETURNING \n    run_id, \n    qid;",
        "options": {
          "queryReplacement": "={{ [ $json.run_id, $json.qid, $json.pertanyaan, $json.jawaban, $json.sumber, $json.benar, $json.bersumber, $json.halusinasi, $json.catatan ] }}"
        }
      },
