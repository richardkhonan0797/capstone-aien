    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    d.id AS qid, \n    d.pertanyaan, \n    d.jenis, \n    d.jawaban_benar AS kunci, \n    COALESCE(d.sumber_benar, '') AS sumber_benar, \n    $1::text AS run_id, \n    COALESCE(\n        (\n            SELECT 'Produk ' || p.nama || ': harga Rp' || p.harga || ', stok ' || p.stok || ', ' || p.deskripsi \n            FROM retail.produk p \n            WHERE p.nama = d.sumber_benar\n        ), \n        (\n            SELECT k.teks \n            FROM retail.dokumen k \n            WHERE k.sumber = d.sumber_benar\n        ), \n        ''\n    ) AS referensi, \n    (\n        SELECT string_agg(nama, '; ' ORDER BY sku) \n        FROM retail.produk\n    ) AS daftar_produk \nFROM retail.eval_dev_set d \nORDER BY d.id \nLIMIT $2::int;",
        "options": {
          "queryReplacement": "={{ [ $json.run_id, $json.limit ] }}"
        }
      },
      "name": "Ambil Dev Set",
      "type": "n8n-nodes-base.postgres",
