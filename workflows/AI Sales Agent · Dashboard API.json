    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    COALESCE(json_agg(t ORDER BY t.id DESC), '[]'::json) AS data \nFROM (\n    SELECT \n        o.id, \n        o.created_at, \n        o.session_id, \n        o.nama_pembeli, \n        o.alamat, \n        o.sku, \n        p.nama AS produk, \n        o.qty, \n        o.total, \n        o.status \n    FROM retail.pesanan o \n    JOIN retail.produk p \n        USING (sku) \n    ORDER BY o.id DESC \n    LIMIT 100\n) t;",
        "options": {}
      },
      "name": "Query Pesanan",
      "type": "n8n-nodes-base.postgres",
