        624
      ],
      "id": "1440a8f9-a815-44fa-baa3-78d622b6cde3",
      "webhookId": "13d4b135-4307-4390-8709-f4ce6f0bb579"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH last AS (\n    SELECT run_id \n    FROM retail.eval_hasil \n    ORDER BY id DESC \n    LIMIT 1\n) \nSELECT \n    json_build_object(\n        'run_id', \n        (SELECT run_id FROM last), \n        'ringkasan', \n        (\n            SELECT json_build_object(\n                'total', count(*), \n                'benar_pct', round(100.0 * avg(benar::int), 1), \n                'bersumber_pct', round(100.0 * avg(bersumber::int), 1), \n                'halusinasi_pct', round(100.0 * avg(halusinasi::int), 1)\n            ) \n            FROM retail.eval_hasil \n            WHERE run_id = (SELECT run_id FROM last)\n        ), \n        'detail', \n        (\n            SELECT COALESCE(\n                json_agg(\n                    json_build_object(\n                        'qid', qid, \n                        'pertanyaan', pertanyaan, \n                        'benar', benar, \n                        'bersumber', bersumber, \n                        'halusinasi', halusinasi, \n                        'catatan', catatan\n                    ) \n                    ORDER BY qid\n                ), \n                '[]'::json\n            ) \n            FROM retail.eval_hasil \n            WHERE run_id = (SELECT run_id FROM last)\n        )\n    ) AS data;",
        "options": {}
      },
